<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_MbParam" Id="{f0d5b0ce-8d53-4a20-b803-213fec7e6af1}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	MB_MAX_POINTS                : UINT := 256;
	MB_MAX_BLOCKS                : UINT := 64;
	MB_LOG_SIZE                  : UINT := 100;
	MB_STR_LEN                   : UINT := 32;
	MB_RAW_WORDS                 : UINT := 8;
	MB_NAME_LEN                  : UINT := 32;
	MB_MAX_DEVICES_PER_TRANSPORT : UINT := 32;
	MB_ADU_SIZE                  : UINT := 260;
	MB_LOG_REPEAT_INTERVAL       : TIME := T#5M;
	MB_OFFLINE_RETRY             : TIME := T#5S;
	MB_LOG_DIR                   : STRING(255) := 'C:\ModbusExt\Logs\';
	MB_LOG_FILE_MAX_BYTES        : UDINT := 2000000;   // Rotate to <name>.1.csv above this
	MB_LOG_FILE_BATCH            : USINT := 20;        // Entries per open/close
	MB_LOG_FILE_RETRY            : TIME  := T#10S;     // Backoff after a file error
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>