<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_MbLogEntry" Id="{65e228c7-719c-45bd-8897-4549060b5022}">
    <Declaration><![CDATA[TYPE ST_MbLogEntry :
STRUCT
	tTime    : ULINT;                                // FILETIME (100 ns, UTC)
	sName    : STRING(GVL_MbParam.MB_NAME_LEN);
	nUnitId  : USINT;
	eRegion  : E_MbRegion;
	nAddr    : UDINT;                                // As entered in the profile
	nFc      : BYTE;
	eOp      : E_MbOp;
	eClass   : E_MbErrorClass;
	nExcCode : BYTE;
	nRetries : USINT;
	nRepeat  : UDINT;                                // StillFailing: occurrences since first failure
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>