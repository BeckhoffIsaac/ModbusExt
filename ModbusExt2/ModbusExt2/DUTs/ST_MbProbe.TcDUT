  <DUT Name="ST_MbProbe" Id="{15c60ed2-c604-4d8c-9db4-18bcc394e689}">
    <Declaration><![CDATA[TYPE ST_MbProbe :
STRUCT
	sName        : STRING(GVL_MbParam.MB_NAME_LEN);
	nAddr        : UDINT;
	aRaw         : ARRAY[0..3] OF WORD;              // First four registers as received
	nInt16       : INT;
	nUInt16      : UINT;
	nInt32_ABCD  : DINT;
	nInt32_CDAB  : DINT;
	nInt32_BADC  : DINT;
	nInt32_DCBA  : DINT;
	nUInt32_ABCD : UDINT;
	nUInt32_CDAB : UDINT;
	nUInt32_BADC : UDINT;
	nUInt32_DCBA : UDINT;
	fReal32_ABCD : REAL;
	fReal32_CDAB : REAL;
	fReal32_BADC : REAL;
	fReal32_DCBA : REAL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
