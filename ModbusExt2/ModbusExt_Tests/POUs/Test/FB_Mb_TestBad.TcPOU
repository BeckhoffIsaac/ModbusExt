<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Mb_TestBad" Id="{e9409718-6059-4b93-b83a-48194780e397}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Mb_TestBad EXTENDS FB_ModbusDevice
VAR_INPUT
	A : ST_MbPoint := (nAddr := 40001);
	B : ST_MbPoint := (nAddr := 40001);                                               // overlap + duplicate name
	C : ST_MbPoint := (nAddr := 20005);                                               // no Modicon range
	D : ST_MbPoint := (nAddr := 40010, eType := E_MbType.RegisterBit, nBit := 16);   // bit out of range
	E : ST_MbPoint := (nAddr := 40020, fEngMax := 100);                               // eng range without raw range
	F : ST_MbPoint := (nAddr := 40030, eType := E_MbType.Text);                       // nRegs missing
	G : ST_MbPoint := (nAddr := 10001, eType := E_MbType.Int16);                      // integer type on a bit region
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Register();
SUPER^();]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{68eea175-d9e3-4d3a-a09d-bfb8c7de860a}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Register();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Reinit" Id="{18d2c2e8-411a-437c-84b3-0cd8c3399021}">
      <Declaration><![CDATA[METHOD FB_Reinit: BOOL
VAR_INPUT   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Register();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Register" Id="{2b167602-6d64-4d6f-8868-309ae29a4a32}">
      <Declaration><![CDATA[METHOD Register
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Profile(sModel := 'TestBad');
AddPoint(A, 'A');
AddPoint(B, 'A');
AddPoint(C, 'C');
AddPoint(D, 'D');
AddPoint(E, 'E');
AddPoint(F, 'F');
AddPoint(G, 'G');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>