<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{d2604a9c-1e7f-4fbb-88a2-792b3944e14d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// Transports — call before the devices that use them
	fbTcp          : FB_MbTransportTcp;
	fbRs485        : FB_MbTransportRtu;

	// Devices
	fbDemo         : FB_Mb_DiagDemo;
	fbMeter        : FB_Mb_TestGood;
	fbTemp		   : FB_ModbusDevice;

	// Write handshake example
	fSetpointCmd   : LREAL;
	bWriteSetpoint : BOOL;

	// Log housekeeping
	fbExport       : FB_MbLogExport;
	bExportLog     : BOOL;
	fbPersist      : FB_WritePersistentData;
	tonPersist     : TON;
	nLastErrors    : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ---- Transports ----
fbTcp(sHost := GVL_Site.sTcpHost, nPort := GVL_Site.nTcpPort);
fbRs485(pComIn := ADR(GVL_IO.stEl6In1), pComOut := ADR(GVL_IO.stEl6Out1), nSizeComIn := SIZEOF(GVL_IO.stEl6In1));

// ---- Devices ----
fbDemo(itfTransport := fbTcp,   nUnitId := GVL_Site.nDemoUnit,  bEnable := TRUE, refLog := GVL_Log.stLogDemo);
fbMeter(itfTransport := fbRs485, nUnitId := GVL_Site.nMeterUnit, bEnable := TRUE, refLog := GVL_Log.stLogMeter);

// ---- Write handshake: set fSetpointCmd, pulse bWriteSetpoint ----
IF bWriteSetpoint AND NOT fbDemo.Setpoint.bWriteReq AND NOT fbDemo.Setpoint.bWriteBusy THEN
	fbDemo.Setpoint.fWriteValue := fSetpointCmd;
	fbDemo.Setpoint.bWriteReq   := TRUE;
END_IF
IF fbDemo.Setpoint.bWriteDone OR fbDemo.Setpoint.bWriteErr THEN
	fbDemo.Setpoint.bWriteReq := FALSE;
	bWriteSetpoint            := FALSE;
END_IF

// ---- Log export on demand ----
fbExport(sPath := 'C:\ModbusExt\demo_log.csv', bExecute := bExportLog, refLog := GVL_Log.stLogDemo);

// ---- Persist the logs 10 s after the error count last changed ----
tonPersist(IN := (GVL_Log.stLogDemo.nTotalErrors + GVL_Log.stLogMeter.nTotalErrors <> nLastErrors), PT := T#10S);
IF tonPersist.Q THEN
	nLastErrors := GVL_Log.stLogDemo.nTotalErrors + GVL_Log.stLogMeter.nTotalErrors;
END_IF
fbPersist(NETID := '', PORT := 851, START := tonPersist.Q, TMOUT := T#5S, MODE := SPDM_2PASS);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>